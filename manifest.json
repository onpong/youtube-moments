{
  "manifest_version": 3,
  "name": "拾刻 · YouTube 时间戳",
  "version": "1.1.0",
  "description": "边看边记，一键收藏 YouTube 视频时间戳。备注、检索、跳转和本地备份。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开拾刻",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shortcut.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "record-moment": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "记录当前视频时间戳"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}